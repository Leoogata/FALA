# =============================================================================
# backend/telephony-handler — variáveis de ambiente
# Copie este arquivo para .env e preencha os valores reais.
# NUNCA versione o arquivo .env.
# =============================================================================

# -----------------------------------------------------------------------------
# Servidor
# -----------------------------------------------------------------------------
PORT=3000

# -----------------------------------------------------------------------------
# Twilio
# Encontre ACCOUNT_SID e AUTH_TOKEN em: Console → Account Info
# PHONE_NUMBER: número provisionado em E.164, ex: +5511900000000
# -----------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# -----------------------------------------------------------------------------
# Controles de voz
# STT_CONFIDENCE_THRESHOLD: confiança mínima da transcrição Twilio (0.0–1.0)
# VOICE_MAX_RETRIES: tentativas antes de encerrar por ausência/baixa confiança
# -----------------------------------------------------------------------------
TWILIO_STT_CONFIDENCE_THRESHOLD=0.6
VOICE_MAX_RETRIES=2

# -----------------------------------------------------------------------------
# IBM watsonx
# API_KEY: chave IBM Cloud (IAM) — Manage → Access → API keys
# PROJECT_ID: ID do projeto watsonx Studio — Manage → General → Details
# AGENT_ORCHESTRATOR_ID: Agent ID do agente orquestrador (fala-orchestrator)
# -----------------------------------------------------------------------------
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
WATSONX_AGENT_ORCHESTRATOR_ID=

# Confiança mínima do orquestrador para aceitar um roteamento (0.0–1.0)
ORCHESTRATOR_CONFIDENCE_THRESHOLD=0.5

# Agent IDs dos subagentes educacionais — um por matéria
# Criados no watsonx Studio conforme watsonx/agent-educational/README-config.md
WATSONX_AGENT_ID_HISTORIA=
WATSONX_AGENT_ID_GEOGRAFIA=
WATSONX_AGENT_ID_PORTUGUES=
WATSONX_AGENT_ID_MATEMATICA=
WATSONX_AGENT_ID_CIENCIAS=

# -----------------------------------------------------------------------------
# URLs de outros serviços
# BACKEND_API_URL: URL do backend/api (ex: https://api.fala.app)
# ANALYTICS_SERVICE_URL: URL do backend/analytics (ex: https://analytics.fala.app)
# -----------------------------------------------------------------------------
BACKEND_API_URL=http://localhost:3001
ANALYTICS_SERVICE_URL=http://localhost:3002

# -----------------------------------------------------------------------------
# Mensagens de voz (opcional — sobrescrevem os defaults do config.js)
# -----------------------------------------------------------------------------
# MSG_BOAS_VINDAS=Olá! Sou o assistente educacional da FALA. Pode fazer sua pergunta sobre qualquer matéria escolar. Estou ouvindo.
# MSG_PROXIMO_TURNO=Pode fazer outra pergunta ou pressione qualquer tecla para encerrar.
# MSG_ENCERRAMENTO=Até logo!
# FALLBACK_MSG_STT_RETRY=Não consegui entender bem. Por favor, fale sua dúvida novamente de forma clara.
# FALLBACK_MSG_STT_ENCERRAR=Não consegui entender sua dúvida. Por favor, tente ligar novamente em um local mais silencioso. Até logo!
# FALLBACK_MSG_SEM_ROTA=Não identifiquei a matéria da sua dúvida. Pode reformular? Por exemplo: Qual é a capital do Brasil? ou O que é fotossíntese?
# FALLBACK_MSG_SEM_RESPOSTA=Ainda não tenho o conteúdo dessa matéria disponível. Consulte seu professor para mais detalhes.
