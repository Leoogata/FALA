# Variáveis de ambiente — Ponte Backend (API de campanhas/documentos)
# Copie este arquivo para .env e preencha os valores
#
# Portas padrão:
#   backend           → 3001  (esta app)
#   telephony-handler → 3000  (porta que o Twilio chama)

# ──────────────────────────────────────────────
# Servidor
# ──────────────────────────────────────────────
NODE_ENV=development
PORT=3001

# ──────────────────────────────────────────────
# Banco de dados (PostgreSQL)
# ──────────────────────────────────────────────
DATABASE_URL=postgresql://usuario:senha@localhost:5432/ponte
# Conexão direta usada pelo Prisma nas migrations (sem pooler).
DIRECT_URL=postgresql://usuario:senha@localhost:5432/ponte

# ──────────────────────────────────────────────
# Autenticação interna entre serviços
# Chave compartilhada com o telephony-handler (mín. 32 caracteres).
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ──────────────────────────────────────────────
INTERNAL_API_KEY=

# ──────────────────────────────────────────────
# Parâmetros de memória de conversa
# ──────────────────────────────────────────────
# CONTEXT_MAX_TURNS=5            # Número máximo de trocas no histórico enviado aos agentes
# CONTEXT_MAX_CHARS=8000         # Limite de caracteres do histórico serializado
# CONVERSATION_RETENTION_HOURS=168     # Retenção em horas (7 dias)
# CONVERSATION_INACTIVITY_MINUTES=30  # Inatividade para encerramento automático

# ──────────────────────────────────────────────
# Upload de arquivos
# Tipos aceitos: PDF e TXT (não configurável — fixo no código)
# ──────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=10

# Documentos PROCESSANDO são reenfileirados automaticamente após restart.

# ──────────────────────────────────────────────
# Pipeline RAG — chunking
# CHUNK_SIZE: número aproximado de caracteres por chunk
# CHUNK_OVERLAP: sobreposição entre chunks consecutivos (melhora recall)
# Tradeoff: chunks maiores = contexto mais rico, embeddings menos precisos
#           chunks menores = embeddings mais precisos, maior custo de indexação
# ──────────────────────────────────────────────
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# ──────────────────────────────────────────────
# Cliente watsonx
# WATSONX_MOCK=true  → usa o mock em memória (somente desenvolvimento/testes)
# WATSONX_MOCK=false → usa o cliente real (requer as variáveis abaixo)
# ──────────────────────────────────────────────
WATSONX_MOCK=false

# ──────────────────────────────────────────────
# RAG — endpoint de busca (/rag/search)
# RAG_INTERNAL_TOKEN: Bearer token fixo para autenticar chamadas internas
#   (telephony-handler → backend). Mín. 16 caracteres. Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# RAG_SEARCH_TOP_K: número de chunks retornados por busca (default 5, máx 20)
# ──────────────────────────────────────────────
RAG_INTERNAL_TOKEN=troque-por-um-token-seguro-de-32-chars
RAG_SEARCH_TOP_K=5

# OCR — idioma(s) do Tesseract para reconhecimento de texto em PDFs escaneados
# Formato: código ISO 639-2, separados por + para múltiplos idiomas
# Requer poppler-utils instalado (incluso no Docker automaticamente)
# Lista de modelos: https://github.com/tesseract-ocr/tessdata
OCR_LANG=por+eng


# Agente único publicado no Prompt Lab (resposta completa, sem streaming)
WATSONX_DEPLOYMENT_ID=01a1ac2a-64c7-748f-8215-d80978470715
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
WATSONX_EMBEDDING_MODEL=ibm/granite-embedding-278m-multilingual
WATSONX_TIMEOUT_MS=20000
VERSAO_PROMPT=agente-unico-v1
RAG_MIN_SCORE=0.35

# Acesso administrativo ao painel (não confundir com o código público de telefone).
# Cada valor deve ter no mínimo 32 caracteres e ser diferente dos demais.
# Exemplo de formato: {"1001":"chave-secreta-gerada-para-a-escola"}
SCHOOL_API_TOKENS={}
