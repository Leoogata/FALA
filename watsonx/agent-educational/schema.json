{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "AnswerQuestionInput": {
      "type": "object",
      "required": [
        "modo",
        "instrucoes",
        "contexto_rag",
        "historico",
        "pergunta"
      ],
      "properties": {
        "modo": {
          "enum": [
            "padrao",
            "escola"
          ]
        },
        "instrucoes": {
          "type": "string"
        },
        "contexto_rag": {
          "type": "string"
        },
        "historico": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "pergunta": {
                "type": "string"
              },
              "resposta": {
                "type": "string"
              }
            }
          }
        },
        "pergunta": {
          "type": "string",
          "maxLength": 500
        }
      }
    },
    "AnswerQuestionOutput": {
      "type": "object",
      "required": [
        "resposta",
        "confianca",
        "sem_resposta",
        "precisa_esclarecimento",
        "pergunta_esclarecimento"
      ],
      "properties": {
        "resposta": {
          "type": "string",
          "maxLength": 1000
        },
        "confianca": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "sem_resposta": {
          "type": "boolean"
        },
        "precisa_esclarecimento": {
          "type": "boolean"
        },
        "pergunta_esclarecimento": {
          "type": "string",
          "maxLength": 300
        }
      }
    }
  }
}
